#: src/Init.php:185 src/PaymentGateway.php:309
msgid "Settings"
msgstr "设置"

#: src/PaymentGateway.php:130
msgid "Alipay Payment Gateway By Wenprise"
msgstr "WooCommerce 的支付宝支付网关"

#: src/PaymentGateway.php:133
msgid "Alipay Payment Gateway for WooCommerce"
msgstr "WooCommerce 的支付宝支付网关"

#: src/PaymentGateway.php:195
msgid "Enable / Disable"
msgstr "启用/停用"

#: src/PaymentGateway.php:196
msgid "Enable this payment gateway"
msgstr "启用此付款网关"

#: src/PaymentGateway.php:201
msgid "Enable Face2Face Payment"
msgstr "启用当面付"

#: src/PaymentGateway.php:202
msgid "Enable Face2Face Payment on PC"
msgstr "在PC端启用当面付"

#: src/PaymentGateway.php:207
msgid "Face2Face QR Code Timeout (Minutes)"
msgstr "当面付二维码超时（分钟）"

#: src/PaymentGateway.php:209
msgid "Set the Face2Face QR code payment timeout in minutes."
msgstr "请设置当面付二维码超时时间（单位为分钟）"

#: src/PaymentGateway.php:217 src/PaymentGateway.php:218
msgid "Enable Alipay Sandbox Mode"
msgstr "启用支付宝沙盒模式"

#: src/PaymentGateway.php:220
#, php-format
msgid ""
"Alipay sandbox can be used to test payments. Sign up for an account <a "
"target=\"_blank\" href=\"%s\">here</a>"
msgstr ""
"支付宝沙盒可用于测试付款。<a target=\"_blank\" href=\"%s\">在此处</a>注册帐户"

#: src/PaymentGateway.php:224
msgid "Title"
msgstr "标题"

#: src/PaymentGateway.php:226
msgid "Alipay"
msgstr "支付宝"

#: src/PaymentGateway.php:229
msgid "Description"
msgstr "描述"

#: src/PaymentGateway.php:231
msgid "Pay securely using Alipay"
msgstr "使用支付宝安全快捷的支付"

#: src/PaymentGateway.php:235
msgid "Order Number Prefix"
msgstr "订单号前缀"

#: src/PaymentGateway.php:237
msgid "Only alphabet or number Allowed"
msgstr "仅允许字母或数字"

#: src/PaymentGateway.php:238
msgid "WC-"
msgstr "WC-"

#: src/PaymentGateway.php:241
msgid "App ID"
msgstr "支付宝 App ID"

#: src/PaymentGateway.php:243
msgid "Enter your Alipay APPID. 开放平台密钥中的\"APPID\"，授权回调地址："
msgstr "请输入支付宝 APPID。该值位于开放平台密钥设置中，授权回调地址："

#: src/PaymentGateway.php:246
msgid "Private Key"
msgstr "应用私钥"

#: src/PaymentGateway.php:248
msgid ""
"Enter your App secret key. (rsa_private_key.pem 文件的全部内容，创建订单时使"
"用)"
msgstr "输入应用私钥，(rsa_private_key.pem 文件的全部内容)"

#: src/PaymentGateway.php:252
msgid "signing mode"
msgstr "加签模式"

#: src/PaymentGateway.php:254
msgid "Select the signing mode。"
msgstr "选择加签模式。"

#: src/PaymentGateway.php:257
msgid "Public Key"
msgstr "公钥"

#: src/PaymentGateway.php:258
msgid "Public Key Certificate"
msgstr "公钥证书"

#: src/PaymentGateway.php:262
msgid "Alipay Public Key"
msgstr "支付宝公钥"

#: src/PaymentGateway.php:264
msgid ""
"Enter your Alipay public key.（开放平台密钥中的\"支付宝公钥\"，验证支付结果时"
"使用）"
msgstr "输入您的支付宝公钥开放平台密钥中的\"支付宝公钥\""

#: src/PaymentGateway.php:267
msgid "alipayCertPublicKey_RSA2.crt Path"
msgstr "alipayCertPublicKey_RSA2.crt 证书"

#: src/PaymentGateway.php:269
#, php-format
msgid ""
"Enter the absolute path of alipayCertPublicKey_RSA2.crt, this is your "
"website root path: %s"
msgstr ""
"请输入alipayCertPublicKey_RSA2.crt 路径的绝对路径，这是您的网站根路径：%s"

#: src/PaymentGateway.php:272
msgid "alipayRootCert.crt Path"
msgstr "alipayRootCert.crt 证书"

#: src/PaymentGateway.php:274
#, php-format
msgid ""
"Enter The absolute path of alipayRootCert.crt, this is your website root "
"path: %s"
msgstr "请输入alipayRootCert.crt 文件的绝对路径, 你网站的根目录路径为： %s"

#: src/PaymentGateway.php:277
msgid "appCertPublicKey.crt Path"
msgstr "appCertPublicKey.crt 证书"

#: src/PaymentGateway.php:279
#, php-format
msgid ""
"Enter The absolute path of appCertPublicKey.crt, this is your website root "
"path: %s"
msgstr "请输入 appCertPublicKey.crt 的绝对路径，这是您的网站根路径：%s"

#: src/PaymentGateway.php:282
msgid "Debug Mode"
msgstr "调试模式"

#: src/PaymentGateway.php:283
msgid "Enable debug mod"
msgstr "启用调试模式"

#: src/PaymentGateway.php:285
msgid "If checked, plugin will show program errors in frontend."
msgstr "如果启用，会在前端显示详情的错误信息。"

#: src/PaymentGateway.php:293
msgid "Exchange Rate"
msgstr "汇率"

#: src/PaymentGateway.php:295
#, php-format
msgid ""
"Please set the %s against Chinese Yuan exchange rate, eg if your currency is "
"US Dollar, then you should enter 6.19"
msgstr "请设置 %s 转人民币的汇率，例如您的商店货币时美元，请填写 6.19"

#: src/PaymentGateway.php:333
#, php-format
msgid ""
"Alipay is enabled, but the store currency is ·not set to Chinese Yuan. "
"Please <a href=\"%1$s\">set the %2$s against the Chinese Yuan exchange rate</"
"a>."
msgstr ""
"支付宝支付已启用，但是您的商店货币不是人民币，请<a href=\"%1$s\">设置 %2$s 转"
"人民币的汇率</a>。"

#: src/PaymentGateway.php:450
#, php-format
msgid "Alipay certificate file is not readable: %s"
msgstr "无法读取支付宝证书文件：%s"

#: src/PaymentGateway.php:591 src/PaymentGateway.php:592
#: src/PaymentGateway.php:653 src/PaymentGateway.php:654
#, php-format
msgid "Pay for order %1$s at %2$s"
msgstr "支付网站「%2$s」中的订单：%1$s"

#: src/PaymentGateway.php:608
msgid "Alipay returned an invalid QR code response."
msgstr "支付宝返回了无效的二维码响应。"

#: src/PaymentGateway.php:615
msgid "Failed to create Alipay QR code."
msgstr "无法生成支付宝二维码。"

#: src/PaymentGateway.php:682
msgid "Failed to create Alipay QR code, please try again."
msgstr "无法生成支付宝二维码，请重试。"

#: src/PaymentGateway.php:749
msgid "Failed to send order to Alipay, please contact us."
msgstr "无法发送订单到支付宝，请联系我们。"

