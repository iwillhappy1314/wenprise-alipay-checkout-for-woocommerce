msgid "Alipay payment has not completed yet."
msgstr "支付宝支付尚未完成。"

#: src/PaymentGateway.php:1305
msgid "Failed to send query order request, please contact us."
msgstr "查询订单时出错，请联系我们。"

#: src/PaymentGateway.php:1330
msgid "You are not allowed to refresh this QR code."
msgstr "您无权刷新此二维码。"

#: src/PaymentGateway.php:1334
msgid "This order does not need payment."
msgstr "此订单无需付款。"

#: src/PaymentGateway.php:1343 src/PaymentGateway.php:1350
#: src/PaymentGateway.php:1360
msgid "Payment successful"
msgstr "支付成功"

#: src/PaymentGateway.php:1374
msgid "QR code refreshed."
msgstr "二维码已刷新。"

#: src/PaymentGateway.php:1378
msgid "Failed to refresh Alipay QR code, please try again."
msgstr "无法刷新支付宝二维码，请重试。"

#: src/PaymentGateway.php:1443
#, php-format
msgid "Refunded %1$s via Alipay"
msgstr "通过支付宝退款 %1$s"

#: src/PaymentGateway.php:1452
#, php-format
msgid "Failed to refunded %1$s. Error message: %2$s"
msgstr "退款失败 %1$s，错误信息: %2$s"

#: src/PaymentGateway.php:1463
msgid "Failed to send refund request, please contact us."
msgstr "无法发送退款请求，请联系我们。"

#: src/PaymentGateway.php:1505
msgid "Alipay returned an invalid response."
msgstr "支付宝返回了无效的响应。"

