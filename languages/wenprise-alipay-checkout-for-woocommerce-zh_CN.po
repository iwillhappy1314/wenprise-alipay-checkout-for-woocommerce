msgid "Alipay payment QR code"
msgstr "支付宝付款二维码"

#: src/PaymentGateway.php:817
msgid "Refresh QR code"
msgstr "刷新二维码"

#: src/PaymentGateway.php:825
msgid "Please scan the QR code with Alipay."
msgstr "请使用支付宝扫描二维码。"

#: src/PaymentGateway.php:834
msgid "Open Alipay, tap Scan, scan the QR code, and confirm payment."
msgstr "打开支付宝，点击扫一扫，扫描二维码并确认付款。"

#: src/PaymentGateway.php:846
msgid "Successfully submitted order!"
msgstr "订单提交成功！"

#: src/PaymentGateway.php:848
msgid ""
"Please verify the payment information above and click the button below to "
"pay via Alipay."
msgstr "请核对上面的付款信息无误后，点击下面的按钮通过支付宝付款。"

#: src/PaymentGateway.php:857
msgid "pay via Alipay"
msgstr "支付宝支付"

#: src/PaymentGateway.php:860
msgid "Check payment results"
msgstr "检查支付结果"

#: src/PaymentGateway.php:1028
msgid "Invalid request."
msgstr "请求无效。"

#: src/PaymentGateway.php:1112
msgid "Failed to close the previous Alipay QR code."
msgstr "无法关闭之前的支付宝二维码。"

#: src/PaymentGateway.php:1251
msgid "Failed to process order, please contact us."
msgstr "无法处理订单，请联系我们。"

